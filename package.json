{
  "name": "job-fill",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Chrome extension to autofill job application forms from a local profile",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && vitest run"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
