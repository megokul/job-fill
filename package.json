{
  "name": "job-fill",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Chrome extension to autofill job application forms from a local profile",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && vitest run",
    "build:e2e-fixtures": "vite build --config e2e/fixtures/react/vite.config.ts",
    "e2e": "npm run build && npm run build:e2e-fixtures && playwright test -c e2e/playwright.config.ts",
    "check:all": "npm run check && npm run e2e"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
